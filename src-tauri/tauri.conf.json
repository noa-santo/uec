{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "uec",
  "version": "0.1.0",
  "identifier": "computer.owo.uec",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "pnpm exec expo start --web --port 8081",
    "beforeBuildCommand": "pnpm exec expo export --platform web"
  },
  "app": {
    "windows": [
      {
        "title": "uec",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
