{
  "name": "uec",
  "description": "Ultimate EMail Client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_TUNNEL_SUBDOMAIN=uecdev expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node scripts/run-tests.cjs",
    "tauri:cli": "pnpm exec tauri",
    "tauri:build": "pnpm exec tauri build",
    "tauri:build:appimage": "APPIMAGE_EXTRACT_AND_RUN=1 pnpm exec tauri build --bundles appimage",
    "build:nix": "nix --extra-experimental-features 'nix-command flakes' build .#uec --option sandbox false",
    "run:nix": "nix --extra-experimental-features 'nix-command flakes' run . --option sandbox false"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@xyflow/react": "^13.0.2",
    "expo": "~58.0.26",
    "expo-auth-session": "~58.0.19",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@expo/ngrok": "^4.1.3",
    "@tauri-apps/cli": "^2.7.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@12.3.4"
}
