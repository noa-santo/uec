# Google OAuth client IDs used by Expo AuthSession.
# For the Tauri/web build, prefer a "Desktop app" OAuth client ID: it supports
# PKCE with no client secret, and the refresh token keeps sessions alive.
# Never commit real credentials to git.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Only needed if EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID is a "Web application" client
# (those require client_secret on Google's token endpoint). Prefer a Desktop app
# client instead, or paste the secret into the Accounts screen at runtime — it
# is stored on the device. Anything prefixed EXPO_PUBLIC_ is bundled into the
# app, so a secret here is visible to anyone with the build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_SECRET=
